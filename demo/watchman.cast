[4.794713, "o", "\u001b[3mDeterministic checks                                                                                       \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1mcheck  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mstatus\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1msummary                                                                        \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtime\u001b[0m\u001b[1m \u001b[0m\r\n━━━━━━━━━╇━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━\r\n secrets │ \u001b[31mfailed\u001b[0m │ 1 possible secret(s) in added lines                                             │ 0.0s \r\n imports │ \u001b[31mfailed\u001b[0m │ checked 5 added import(s)                                                       │ 0.0s \r\n hygiene │ \u001b[31mfailed\u001b[0m │ 1 hygiene issue(s)                                                              │ 0.0s \r\n ruff    │ \u001b[31mfailed\u001b[0m │ 3 violation(s) on changed lines                                                 │ 0.0s \r\n mypy    │ \u001b[31mfailed\u001b[0m │ 1 type error(s) on changed lines (third-party imports unresolved: no repo venv) │ 0.7s \r\n"]
