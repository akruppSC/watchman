[4.79982, "o", "\u001b[2mmode=deterministic  findings=6  latency=0.7s\u001b[0m\r\nverdict: \u001b[1;31mBLOCK\u001b[0m\r\n"]
[4.866342, "o", "\r\n\u001b[1;36m# Step 2: the LLM reviewer. It plans, verifies with tools, and cites its evidence.\u001b[0m\r\n"]
[6.369409, "o", "\u001b[1;32m$\u001b[0m watchman review --base main --head HEAD --mode agent --model google/gemini-3.7-flash --task 'Add retries and a config loader' --checks secrets,imports,hygiene,ruff,mypy --fail-on never\r\n"]
