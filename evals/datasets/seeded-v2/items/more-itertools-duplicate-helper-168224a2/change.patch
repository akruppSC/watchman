@@ -4707,3 +4729,34 @@ def powerset_of_sets(iterable):
     sets = tuple(map(set, dict.fromkeys(map(frozenset, zip(iterable)))))
     for r in range(len(sets) + 1):
         yield from starmap(set().union, combinations(sets, r))
