+def _all_equal_impl(iterable, key=None):
+    """
+    Returns ``True`` if all the elements are equal to each other.
+
+        >>> _all_equal_impl('aaaa')
+        True
+        >>> _all_equal_impl('aaab')
+        False
+
+    A function that accepts a single argument and returns a transformed version
+    of each input item can be specified with *key*:
+
+        >>> _all_equal_impl('AaaA', key=str.casefold)
+        True
+        >>> _all_equal_impl([1, 2, 3], key=lambda x: x < 10)
+        True
+
+    """
+    return len(list(islice(groupby(iterable, key), 2))) <= 1
+
