+def ne(val):
+    """
+    A validator that raises `ValueError` if the initializer is called with a
+    number equal to *val*.
+
+    The validator uses `operator.ne` to compare the values.
+
+    Args:
+       val: The value that is not allowed.
+
+    .. versionadded:: 26.2.0
+    """
+    return _NumberValidator(val, "!=", operator.ne)
