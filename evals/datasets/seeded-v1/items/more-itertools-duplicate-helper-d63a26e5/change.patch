+def _first_true_impl(iterable, default=None, predicate=None):
+    """
+    Returns the first true value in the iterable.
+
+    If no true value is found, returns *default*
+
+    If *pred* is not None, returns the first item for which
+    ``pred(item) == True`` .
+
+        >>> _first_true_impl(range(10))
+        1
+        >>> _first_true_impl(range(10), predicate=lambda x: x > 5)
+        6
+        >>> _first_true_impl(range(10), default='missing', predicate=lambda x: x > 9)
+        'missing'
+
+    """
+    return next(filter(predicate, iterable), default)
+
